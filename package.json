{
  "name": "sreenivasulu-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Personal developer portfolio for P. Sreenivasulu",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix client run dev",
    "dev:api": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
